<h1><%- title %></h1>

<%- messages() %>

<div class="profile-container">
    <p><%- account_firstname %>, here are your favorite vehicles:</p>

    <% if (favorites && favorites.length > 0) { %>
        <ul id="favorites-display">
            <% favorites.forEach(vehicle => { %>
                <li>
                    <a href="/inv/detail/<%= vehicle.inv_id %>" title="View <%= vehicle.inv_make %> <%= vehicle.inv_model %> details">
                        <img src="<%= vehicle.inv_thumbnail %>" alt="Image of <%= vehicle.inv_make %> <%= vehicle.inv_model %>">
                    </a>
                    <div class="namePrice">
                        <h2>
                            <a href="/inv/detail/<%= vehicle.inv_id %>">
                                <%= vehicle.inv_make %> <%= vehicle.inv_model %> (<%= vehicle.inv_year %>)
                            </a>
                        </h2>
                        <span>$<%= new Intl.NumberFormat('en-US').format(vehicle.inv_price) %></span>
                    </div>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p class="notice">You have no favorite vehicles yet. Browse our <a href="/">inventory</a> to add some!</p>
    <% } %>

    <p><a href="/account/profile">Back to Profile</a></p>
</div>

<style>
    #favorites-display {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5em;
        list-style-type: none;
        padding: 0;
        margin-top: 1em;
        justify-items: center;
    }
    #favorites-display li {
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 500px;
    }
    #favorites-display li a img {
        width: 100%;
        height: 250px;
        object-fit: cover;
        object-position: center;
        border-bottom: 1px solid #eee;
    }
    #favorites-display .namePrice {
        padding: 1em;
        text-align: center;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    #favorites-display .namePrice h2 {
        margin: 0.5em 0;
        font-size: 1.2rem;
    }
    #favorites-display .namePrice span {
        font-size: 1.1rem;
        font-weight: bold;
        color: #065318;
        margin-top: 0.5em;
    }
</style>